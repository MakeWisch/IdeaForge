# ==============================================================================
# AI Provider Configuration
# ==============================================================================

# Active primary AI provider: 'gemini' | 'openai' | 'anthropic' (default: 'gemini')
AI_PROVIDER="gemini"

# Optional model override (leave blank to use provider default)
# Examples:
#   Gemini: 'gemini-3.8-flash'
#   OpenAI: 'gpt-4o-mini' or 'gpt-4o'
#   Anthropic: 'claude-3-5-sonnet-20241022'
AI_MODEL=""

# Optional fallback provider if primary provider hits transient 429/503 rate limits
# AI_FALLBACK_PROVIDER="openai"

# ==============================================================================
# Secret API Keys (Server-side only — never commit real keys to git)
# ==============================================================================

# Gemini: injected automatically in AI Studio, or obtained from Google AI Studio
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI: obtained from https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic: obtained from https://console.anthropic.com/
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# App hosting URL (set automatically by hosting environment)
APP_URL="MY_APP_URL"
